<?xml version="1.0" encoding="UTF-8"?>
<!-- Lucent theme for Seren - Scraping / searching for streams -->
<window type="dialog">
    <coordinates>
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
    </coordinates>

    <controls>

        <!-- ============ Cinematic backdrop ============ -->
        <control type="group">
            <control type="image">
                <texture>lucent/white.png</texture>
                <colordiffuse>FF0B1119</colordiffuse>
            </control>
            <control type="image">
                <animation effect="fade" start="0" end="100" time="600">WindowOpen</animation>
                <aspectratio>scale</aspectratio>
                <texture background="true">$INFO[Window().Property(item.art.fanart)]</texture>
            </control>
            <control type="image">
                <width>1500</width>
                <texture>lucent/grad_left.png</texture>
                <colordiffuse>F50B1119</colordiffuse>
            </control>
            <control type="image">
                <top>440</top>
                <height>640</height>
                <texture>lucent/grad_bottom.png</texture>
                <colordiffuse>FF0B1119</colordiffuse>
            </control>
            <control type="image">
                <texture>lucent/vignette.png</texture>
                <colordiffuse>99000000</colordiffuse>
            </control>
        </control>

        <!-- ============ Logo / title ============ -->
        <control type="group">
            <animation effect="fade" start="0" end="100" time="400" delay="100">WindowOpen</animation>
            <animation effect="slide" start="-60,0" end="0,0" time="400" delay="100" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" end="0" time="300">WindowClose</animation>
            <left>96</left>
            <top>96</top>
            <width>760</width>

            <control type="image">
                <width>560</width>
                <height>220</height>
                <aspectratio align="left" aligny="bottom">keep</aspectratio>
                <texture>$INFO[Window().Property(item.art.clearlogo)]</texture>
                <visible>!String.IsEmpty(Window().Property(item.art.clearlogo))</visible>
            </control>
            <control type="textbox">
                <top>100</top>
                <width>760</width>
                <height>120</height>
                <font>font37</font>
                <textcolor>FFFFFFFF</textcolor>
                <aligny>bottom</aligny>
                <label>[B]$INFO[Window().Property(item.info.tvshowtitle)][/B]</label>
                <visible>String.IsEmpty(Window().Property(item.art.clearlogo)) + !String.IsEmpty(Window().Property(item.info.season))</visible>
            </control>
            <control type="textbox">
                <top>100</top>
                <width>760</width>
                <height>120</height>
                <font>font37</font>
                <textcolor>FFFFFFFF</textcolor>
                <aligny>bottom</aligny>
                <label>[B]$INFO[Window().Property(item.info.title)][/B]</label>
                <visible>String.IsEmpty(Window().Property(item.art.clearlogo)) + String.IsEmpty(Window().Property(item.info.season))</visible>
            </control>

            <control type="label">
                <top>252</top>
                <width>760</width>
                <height>40</height>
                <font>font12</font>
                <textcolor>FFDCE2E7</textcolor>
                <label>[B]S$INFO[Window().Property(item.info.season)] · E$INFO[Window().Property(item.info.episode)][/B]$INFO[Window().Property(item.info.title),   ,]</label>
                <visible>!String.IsEmpty(Window().Property(item.info.season))</visible>
            </control>
            <control type="label">
                <top>252</top>
                <width>760</width>
                <height>40</height>
                <font>font12</font>
                <textcolor>FFDCE2E7</textcolor>
                <label>$INFO[Window().Property(item.info.year)]$INFO[Window().Property(item.info.mpaa),  ·  ,]</label>
                <visible>String.IsEmpty(Window().Property(item.info.season))</visible>
            </control>
        </control>

        <!-- ============ Notification before scraping starts ============ -->
        <control type="label">
            <left>96</left>
            <top>760</top>
            <width>1200</width>
            <height>40</height>
            <font>font12</font>
            <textcolor>FFBDC8D1</textcolor>
            <label>$INFO[Window().Property(notification_text)]</label>
            <visible>String.IsEqual(Window().Property(process_started),false)</visible>
        </control>

        <!-- ============ Glass progress card ============ -->
        <control type="group">
            <animation effect="fade" time="350" condition="String.IsEqual(Window().Property(process_started),true)">Conditional</animation>
            <animation effect="slide" start="0,60" end="0,0" time="400" tween="cubic" easing="out" condition="String.IsEqual(Window().Property(process_started),true)">Conditional</animation>
            <animation effect="fade" end="0" time="300">WindowClose</animation>
            <left>96</left>
            <top>660</top>
            <width>840</width>
            <height>324</height>
            <visible>String.IsEqual(Window().Property(process_started),true)</visible>

            <control type="image">
                <left>-40</left>
                <top>-40</top>
                <width>920</width>
                <height>404</height>
                <texture border="88">lucent/panel_shadow.png</texture>
                <colordiffuse>80000000</colordiffuse>
            </control>
            <control type="image">
                <texture border="48">lucent/panel.png</texture>
                <colordiffuse>E0162532</colordiffuse>
            </control>
            <control type="image">
                <texture border="48">lucent/panel_edge.png</texture>
                <colordiffuse>2EFFFFFF</colordiffuse>
            </control>

            <!-- Header -->
            <control type="label">
                <left>40</left>
                <top>28</top>
                <width>560</width>
                <height>44</height>
                <font>font27</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>[B]Streams zoeken[/B]</label>
            </control>
            <control type="label">
                <right>40</right>
                <top>28</top>
                <width>200</width>
                <height>44</height>
                <font>font27</font>
                <align>right</align>
                <textcolor>FFFFFFFF</textcolor>
                <label>[B]$INFO[Window().Property(totals_total)][/B]</label>
            </control>

            <!-- Progress track -->
            <control type="group">
                <left>40</left>
                <top>96</top>
                <width>760</width>
                <height>6</height>
                <control type="image">
                    <texture border="3">lucent/pill6.png</texture>
                    <colordiffuse>1FFFFFFF</colordiffuse>
                </control>
                <control type="image">
                    <left>0</left>
                    <width>38</width>
                    <height>6</height>
                    <texture>lucent/white.png</texture>
                    <colordiffuse>FFFFFFFF</colordiffuse>
                    <animation effect="fade" start="0" end="100" time="200">VisibleChange</animation>
                    <visible>Integer.IsGreaterOrEqual(Window().Property(progress),5)</visible>
                </control>
                <control type="image">
                    <left>38</left>
