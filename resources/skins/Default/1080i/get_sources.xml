            <!-- Quality pills -->
            <control type="grouplist">
                <left>40</left>
                <top>130</top>
                <width>760</width>
                <height>48</height>
                <orientation>horizontal</orientation>
                <itemgap>12</itemgap>
                    <control type="button">
                        <width>auto</width>
                        <height>48</height>
                        <font>font12</font>
                        <textoffsetx>22</textoffsetx>
                        <aligny>center</aligny>
                        <textcolor>FFDCE2E7</textcolor>
                        <disabledcolor>FFDCE2E7</disabledcolor>
                        <texturenofocus border="24" colordiffuse="1AFFFFFF">lucent/pill48.png</texturenofocus>
                        <texturefocus border="24" colordiffuse="1AFFFFFF">lucent/pill48.png</texturefocus>
                        <enable>false</enable>
                        <label>[B]4K[/B]   $INFO[Window().Property(totals_4K)]</label>
                    </control>
                    <control type="button">
                        <width>auto</width>
                        <height>48</height>
                        <font>font12</font>
                        <textoffsetx>22</textoffsetx>
                        <aligny>center</aligny>
                        <textcolor>FFDCE2E7</textcolor>
                        <disabledcolor>FFDCE2E7</disabledcolor>
                        <texturenofocus border="24" colordiffuse="1AFFFFFF">lucent/pill48.png</texturenofocus>
                        <texturefocus border="24" colordiffuse="1AFFFFFF">lucent/pill48.png</texturefocus>
                        <enable>false</enable>
                        <label>[B]1080p[/B]   $INFO[Window().Property(totals_1080p)]</label>
                    </control>
                    <control type="button">
                        <width>auto</width>
                        <height>48</height>
                        <font>font12</font>
                        <textoffsetx>22</textoffsetx>
                        <aligny>center</aligny>
                        <textcolor>FFDCE2E7</textcolor>
                        <disabledcolor>FFDCE2E7</disabledcolor>
                        <texturenofocus border="24" colordiffuse="1AFFFFFF">lucent/pill48.png</texturenofocus>
                        <texturefocus border="24" colordiffuse="1AFFFFFF">lucent/pill48.png</texturefocus>
                        <enable>false</enable>
                        <label>[B]720p[/B]   $INFO[Window().Property(totals_720p)]</label>
                    </control>
                    <control type="button">
                        <width>auto</width>
                        <height>48</height>
                        <font>font12</font>
                        <textoffsetx>22</textoffsetx>
                        <aligny>center</aligny>
                        <textcolor>FFDCE2E7</textcolor>
                        <disabledcolor>FFDCE2E7</disabledcolor>
                        <texturenofocus border="24" colordiffuse="1AFFFFFF">lucent/pill48.png</texturenofocus>
                        <texturefocus border="24" colordiffuse="1AFFFFFF">lucent/pill48.png</texturefocus>
                        <enable>false</enable>
                        <label>[B]SD[/B]   $INFO[Window().Property(totals_SD)]</label>
                    </control>
            </control>

            <!-- Per source type -->
            <control type="grouplist">
                <left>40</left>
                <top>200</top>
                <width>760</width>
                <height>36</height>
                <orientation>horizontal</orientation>
                <itemgap>32</itemgap>
                    <control type="label">
                        <width>auto</width>
                        <height>36</height>
                        <font>font12</font>
                        <textcolor>FF8F9BA6</textcolor>
                        <label>Torrents  [COLOR FFFFFFFF]$INFO[Window().Property(torrents_total)][/COLOR]</label>
                        <visible>String.IsEqual(Window().Property(has_torrent_providers),true)</visible>
                    </control>
                    <control type="label">
                        <width>auto</width>
                        <height>36</height>
                        <font>font12</font>
                        <textcolor>FF8F9BA6</textcolor>
                        <label>Cached  [COLOR FFFFFFFF]$INFO[Window().Property(torrentsCached_total)][/COLOR]</label>
                        <visible>String.IsEqual(Window().Property(has_torrent_providers),true)</visible>
                    </control>
                    <control type="label">
                        <width>auto</width>
                        <height>36</height>
                        <font>font12</font>
                        <textcolor>FF8F9BA6</textcolor>
                        <label>Hosters  [COLOR FFFFFFFF]$INFO[Window().Property(hosters_total)][/COLOR]</label>
                        <visible>String.IsEqual(Window().Property(has_hoster_providers),true)</visible>
                    </control>
                    <control type="label">
                        <width>auto</width>
                        <height>36</height>
                        <font>font12</font>
                        <textcolor>FF8F9BA6</textcolor>
                        <label>Cloud  [COLOR FFFFFFFF]$INFO[Window().Property(cloudFiles_total)][/COLOR]</label>
                        <visible>String.IsEqual(Window().Property(has_cloud_scrapers),true)</visible>
                    </control>
                    <control type="label">
                        <width>auto</width>
                        <height>36</height>
                        <font>font12</font>
                        <textcolor>FF8F9BA6</textcolor>
                        <label>Adaptive  [COLOR FFFFFFFF]$INFO[Window().Property(adaptiveSources_total)][/COLOR]</label>
                        <visible>String.IsEqual(Window().Property(has_adaptive_providers),true)</visible>
                    </control>
                    <control type="label">
                        <width>auto</width>
                        <height>36</height>
                        <font>font12</font>
                        <textcolor>FF8F9BA6</textcolor>
                        <label>Direct  [COLOR FFFFFFFF]$INFO[Window().Property(directSources_total)][/COLOR]</label>
                        <visible>String.IsEqual(Window().Property(has_direct_providers),true)</visible>
                    </control>
            </control>

            <!-- Remaining providers -->
            <control type="label">
                <left>40</left>
                <top>254</top>
                <width>760</width>
                <height>36</height>
                <font>font12</font>
                <textcolor>FF6F7C88</textcolor>
                <scroll>true</scroll>
                <label>[UPPERCASE]$INFO[Window().Property(remaining_providers_list)][/UPPERCASE]</label>
                <visible>!Integer.IsGreaterOrEqual(Window().Property(remaining_providers_count),10)</visible>
            </control>
            <control type="label">
                <left>40</left>
                <top>254</top>
                <width>760</width>
                <height>36</height>
                <font>font12</font>
                <textcolor>FF6F7C88</textcolor>
                <label>$ADDON[plugin.video.seren 30250]: $INFO[Window().Property(remaining_providers_count)]</label>
                <visible>Integer.IsGreaterOrEqual(Window().Property(remaining_providers_count),10)</visible>
            </control>
        </control>

        <!-- Required by Seren (hidden) -->
        <control type="list" id="2000">
            <visible>false</visible>
            <left>0</left>
            <top>0</top>
            <width>10</width>
            <height>10</height>
            <itemlayout width="10" height="10">
                <control type="label">
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="10" height="10">
                <control type="label">
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
